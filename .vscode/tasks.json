{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build desktop/Minify.Desktop.slnx"
    },
    {
      "label": "run",
      "type": "shell",
      "command": "dotnet run --project desktop/Minify.Desktop",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "uv run pytest && dotnet test desktop/Minify.Desktop.slnx"
    },
    {
      "label": "patch",
      "type": "shell",
      "command": "uv run Minify patch"
    }
  ]
}
