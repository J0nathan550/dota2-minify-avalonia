<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Minify.Desktop.ViewModels"
        xmlns:backend="using:Minify.Desktop.Backend"
        xmlns:views="using:Minify.Desktop.Views"
        x:Class="Minify.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Version, StringFormat='Minify {0}'}"
        Icon="/Assets/favicon.ico"
        Width="960" Height="680" MinWidth="700" MinHeight="500"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.log">
      <Setter Property="FontFamily" Value="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,12">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="/Assets/favicon.ico" Width="28" Height="28" />
        <TextBlock Text="Minify" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsReady}">
        <Button Content="{Binding Loc[button_uninstall]}" Command="{Binding UninstallCommand}" />
        <Button Classes="accent" MinWidth="120" HorizontalContentAlignment="Center"
                Content="{Binding PatchButtonText}" Command="{Binding PatchCommand}" />
      </StackPanel>
    </Grid>

    <!-- Main content -->
    <TabControl Grid.Row="1" Margin="8,0" IsVisible="{Binding IsReady}" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{Binding Loc[tab_mods]}">
        <Grid RowDefinitions="Auto,*">
          <TextBox PlaceholderText="{Binding Loc[placeholder_search_mods]}" Text="{Binding SearchText}"
                   Margin="8,8,8,4" MaxWidth="360" HorizontalAlignment="Left" />
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Mods}" Margin="4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemWidth="220" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModItemViewModel">
                  <Border Classes="card" Margin="6">
                    <Grid RowDefinitions="110,Auto">
                      <Border Background="{DynamicResource PreviewPlaceholderBrush}">
                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                      </Border>
                      <CheckBox Grid.Row="1" Margin="10,6" IsChecked="{Binding IsEnabled}"
                                IsEnabled="{Binding CanToggle}">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding DisplayName}" />
                      </CheckBox>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding Loc[tab_terminal]}">
        <Grid RowDefinitions="*,Auto">
          <Border Classes="card" Margin="8" Background="#FF1B1B1F">
            <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent" Padding="6">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="4,1" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="backend:LogEntry">
                  <SelectableTextBlock Classes="log" Text="{Binding Text}"
                                       Foreground="{Binding Type, Converter={x:Static views:LogBrushConverter.Instance}}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Button Grid.Row="1" Margin="8,0,8,8" HorizontalAlignment="Right"
                  Content="{Binding Loc[button_clear]}" Command="{Binding ClearLogsCommand}" />
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Startup / problem states -->
    <StackPanel Grid.Row="1" IsVisible="{Binding IsStarting}" Spacing="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <ProgressBar IsIndeterminate="True" Width="220" />
      <TextBlock Text="Starting Minify…" HorizontalAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="1" IsVisible="{Binding IsSteamMissing}" Spacing="12" MaxWidth="440"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Dota 2 not found" FontSize="18" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap"
                 Text="Minify couldn't find Dota 2 in your Steam libraries. Select the folder Steam is installed in (the one containing steamapps or the libraryfolders config)." />
      <Button Classes="accent" Content="Select Steam folder…" Command="{Binding LocateSteamCommand}" />
    </StackPanel>

    <StackPanel Grid.Row="1" IsVisible="{Binding IsFailed}" Spacing="12" MaxWidth="480"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Something went wrong" FontSize="18" FontWeight="SemiBold" />
      <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      <Button Content="Retry" Command="{Binding RestartCommand}" />
    </StackPanel>

    <!-- Status bar -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="16,4,16,8">
      <TextBlock Text="{Binding DownloadStatus}" Opacity="0.8" />
      <TextBlock Grid.Column="1" Text="{Binding Version, StringFormat='v{0}'}" Opacity="0.5" />
    </Grid>
  </Grid>
</Window>
