<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Minify.Desktop.ViewModels"
        xmlns:views="using:Minify.Desktop.Views"
        x:Class="Minify.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Version, StringFormat='Minify {0}'}"
        Icon="/Assets/favicon.ico"
        Width="1000" Height="700" MinWidth="720" MinHeight="500"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding CycleTabCommand}" CommandParameter="{x:True}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding CycleTabCommand}" CommandParameter="{x:False}" />
  </Window.KeyBindings>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:ModsPageViewModel"><views:ModsPage /></DataTemplate>
    <DataTemplate DataType="vm:TerminalPageViewModel"><views:TerminalPage /></DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel"><views:SettingsPage /></DataTemplate>
    <DataTemplate DataType="vm:WebPluginPageViewModel"><views:WebPluginPage /></DataTemplate>
    <DataTemplate DataType="vm:D2pfxPageViewModel"><views:D2pfxPage /></DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header: logo, page tabs, links, main actions -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,10,12,4">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
        <Image Source="/Assets/favicon.ico" Width="26" Height="26" />
        <TextBlock Text="Minify" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <ListBox Grid.Column="1" Classes="tabs" IsVisible="{Binding IsReady}"
               ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PageViewModel">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsReady}">
        <Button Classes="icon" ToolTip.Tip="Links">
          <PathIcon Data="{StaticResource IconWeb}" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeaderLink">
                    <Button Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenLinkCommand}"
                            CommandParameter="{Binding Url}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{Binding Icon, Converter={x:Static views:MainWindow.IconByKey}}" />
                        <TextBlock Text="{Binding Title}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Classes="icon" ToolTip.Tip="{Binding Loc[title_download_workshop_tools]}"
                IsVisible="{Binding IsWorkshopMissing}" Command="{Binding DownloadWorkshopToolsCommand}">
          <PathIcon Data="{StaticResource IconHammer}" />
        </Button>
        <Button Classes="icon" ToolTip.Tip="Open config directory" Command="{Binding OpenConfigDirectoryCommand}">
          <PathIcon Data="{StaticResource IconFolder}" />
        </Button>
        <Button Content="{Binding Loc[button_uninstall]}" Command="{Binding UninstallCommand}" Margin="6,0,0,0" />
        <Button Classes="accent" MinWidth="120" HorizontalContentAlignment="Center"
                Content="{Binding PatchButtonText}" Command="{Binding PatchCommand}" />
      </StackPanel>
    </Grid>

    <!-- Selected page -->
    <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" IsVisible="{Binding IsReady}" />

    <!-- Startup / problem states -->
    <StackPanel Grid.Row="1" IsVisible="{Binding IsStarting}" Spacing="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <ProgressBar IsIndeterminate="True" Width="220" />
      <TextBlock Text="Starting Minify…" HorizontalAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="1" IsVisible="{Binding IsSteamMissing}" Spacing="12" MaxWidth="440"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Classes="h2" Text="Dota 2 not found" />
      <TextBlock TextWrapping="Wrap"
                 Text="Minify couldn't find Dota 2 in your Steam libraries. Select the folder Steam is installed in (the one containing steamapps or the libraryfolders config)." />
      <Button Classes="accent" Content="Select Steam folder…" Command="{Binding LocateSteamCommand}" />
    </StackPanel>

    <StackPanel Grid.Row="1" IsVisible="{Binding IsFailed}" Spacing="12" MaxWidth="480"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Classes="h2" Text="Something went wrong" />
      <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      <Button Content="Retry" Command="{Binding RestartCommand}" />
    </StackPanel>

    <!-- Download notifications -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Downloads}" Width="300" Margin="16"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DownloadItemViewModel">
          <Border Classes="card" Padding="12,8" Margin="0,6,0,0" BoxShadow="0 4 16 0 #40000000">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Classes="icon" Padding="2"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DismissDownloadCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                </Button>
              </Grid>
              <TextBlock Classes="muted" Text="{Binding Details}" TextWrapping="Wrap" />
              <ProgressBar Value="{Binding Percent}" IsVisible="{Binding HasTotal}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Status bar -->
    <TextBlock Grid.Row="2" Classes="muted" Margin="16,2,16,6" HorizontalAlignment="Right"
               Text="{Binding Version, StringFormat='v{0}'}" />
  </Grid>
</Window>
