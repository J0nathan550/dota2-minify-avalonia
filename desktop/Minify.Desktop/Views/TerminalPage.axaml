<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Minify.Desktop.ViewModels"
             x:Class="Minify.Desktop.Views.TerminalPage"
             x:DataType="vm:TerminalPageViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,8,12,4">
      <TextBlock Classes="h2" Text="{Binding Loc[title_terminal]}" VerticalAlignment="Center" />
      <CheckBox Grid.Column="1" Margin="0,0,12,0" IsChecked="{Binding AutoScroll}"
                Content="{Binding Loc[label_autoscroll]}" />
      <Button Grid.Column="2" Content="{Binding Loc[button_clear]}" Command="{Binding ClearCommand}" />
    </Grid>
    <Border Grid.Row="1" Classes="code" Margin="12,4,12,12">
      <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent" Padding="6">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogLine">
            <Panel>
              <Separator IsVisible="{Binding IsSeparator}" Margin="0,4" />
              <SelectableTextBlock Classes="log" Text="{Binding Text}" IsVisible="{Binding !IsSeparator}"
                                   Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}"
                                   Classes.success="{Binding IsSuccess}" />
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
