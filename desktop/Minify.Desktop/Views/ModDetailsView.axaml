<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Minify.Desktop.ViewModels"
             xmlns:md="using:Markdown.Avalonia"
             x:Class="Minify.Desktop.Views.ModDetailsView"
             x:DataType="vm:ModDetailsViewModel">
  <Grid>
    <ScrollViewer Padding="20,0,20,8">
      <StackPanel Spacing="16">
        <TextBlock Text="{Binding Loc[loading]}" IsVisible="{Binding IsLoading}" Classes="muted" />
        <SelectableTextBlock Text="{Binding Error}" Foreground="{DynamicResource LogErrorBrush}"
                             IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Loc[label_no_mod_details]}" IsVisible="{Binding IsEmpty}" Classes="muted" />

        <!-- Preview and notes side by side when there is room. -->
        <Grid ColumnDefinitions="Auto,*">
          <Button Padding="0" Margin="0,0,16,0" VerticalAlignment="Top" Background="Transparent"
                  IsVisible="{Binding HasPreview}" Command="{Binding ToggleLightboxCommand}"
                  ToolTip.Tip="{Binding Loc[title_click_to_preview]}" Cursor="Hand">
            <Border Classes="card" Width="320">
              <Image Source="{Binding Preview}" Stretch="Uniform" />
            </Border>
          </Button>
          <md:MarkdownScrollViewer Grid.Column="1" Markdown="{Binding Notes}" IsVisible="{Binding HasNotes}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Methods}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModMethodViewModel">
              <Expander HorizontalAlignment="Stretch" Margin="0,0,0,6">
                <Expander.Header>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{Binding Icon}" Width="28" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                    <Border Grid.Column="2" Classes="card" Padding="8,1" CornerRadius="10" IsVisible="{Binding HasBadge}">
                      <TextBlock Text="{Binding Badge}" FontSize="12" />
                    </Border>
                  </Grid>
                </Expander.Header>
                <Panel>
                  <TreeView ItemsSource="{Binding Tree}" IsVisible="{Binding IsTree}" MaxHeight="360">
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate x:DataType="vm:FileNodeViewModel" ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Grid.Column="1" Classes="muted" Margin="16,0,0,0" Text="{Binding Size}" />
                        </Grid>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>

                  <Border Classes="code" Padding="8"
                          IsVisible="{Binding HasLines}" MaxHeight="420">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CodeLine">
                            <Grid ColumnDefinitions="44,*">
                              <TextBlock Classes="log" Opacity="0.45" TextAlignment="Right" Margin="0,0,12,0"
                                         Text="{Binding Number}" />
                              <SelectableTextBlock Grid.Column="1" Classes="log" TextWrapping="NoWrap"
                                                   Text="{Binding Text}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>

                  <TextBlock Classes="muted" Text="{Binding $parent[UserControl].((vm:ModDetailsViewModel)DataContext).Loc[label_empty_file]}"
                             IsVisible="{Binding IsEmpty}" />
                </Panel>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Full-size preview; click or Escape closes it. -->
    <Border Background="#CC000000" IsVisible="{Binding IsLightboxOpen}"
            Tapped="OnLightboxTapped" Cursor="Hand">
      <Image Source="{Binding Preview}" Stretch="Uniform" Margin="24" />
    </Border>
  </Grid>
</UserControl>
