<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Square icon button used in the header and on cards. -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- The page tab strip in the header. -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.log, SelectableTextBlock.log">
    <Setter Property="FontFamily" Value="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TerminalTextBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.log.error">
    <Setter Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.log.warning">
    <Setter Property="Foreground" Value="{DynamicResource LogWarningBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.log.success">
    <Setter Property="Foreground" Value="{DynamicResource LogSuccessBrush}" />
  </Style>
</Styles>
